{
  "name": "survival-shelf",
  "description": "Build your emergency supplies step by step and never let them expire. The app lives in app/, the practical guides in guides/ and the documentation in docs/.",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "app"
  ],
  "scripts": {
    "dev": "npm run dev -w app --",
    "build": "npm run build -w app --",
    "build:single": "npm run build:single -w app --",
    "build:all": "npm run build:all -w app --",
    "preview": "npm run preview -w app --",
    "check": "npm run check -w app --",
    "test": "npm run test -w app --",
    "test:watch": "npm run test:watch -w app --"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/sylvaindeloux/survival-shelf.git"
  },
  "engines": {
    "node": ">=22.12"
  },
  "overrides": {
    "workbox-build": {
      "glob": "^14.0.6"
    }
  }
}
